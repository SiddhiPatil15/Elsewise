# Frontend Environment Variables (Vercel)
# Add these to Vercel dashboard > Project Settings > Environment Variables
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Backend Environment Variables (Render)
# Add these to Render dashboard > Web Service > Environment
# FIREBASE_SERVICE_ACCOUNT_BASE64 is a base64 encoded string of your firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_BASE64=your-base64-encoded-service-account
